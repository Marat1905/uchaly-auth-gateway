{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Authentication": "Debug",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",

  "Authentik": {
    "Authority": "http://authentik-server:9000",
    "MetadataAddress": "http://authentik-server:9000/application/o/uchaly/.well-known/openid-configuration",
    "ClientId": "uchaly-frontend",
    "Audience": "uchaly-frontend",
    "RequireHttpsMetadata": false,
    "ValidateIssuer": true,
    "ValidateAudience": true,
    "ValidateLifetime": true,
    "ValidateIssuerSigningKey": true,
    "ClockSkewMinutes": 5,
    "GroupsClaim": "groups",
    "RoleClaimPrefix": "",
    "FrontendCallbackUrl": "/auth/callback",
    "FrontendLoginUrl": "/login"
  },

  "ReverseProxy": {
    "Routes": {
      "monitoring-nodes": {
        "ClusterId": "monitoring-cluster",
        "Match": { "Path": "/api/Nodes/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/Nodes/{**catch-all}" }
        ]
      },
      "monitoring-alerts": {
        "ClusterId": "monitoring-cluster",
        "Match": { "Path": "/api/Alerts/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/Alerts/{**catch-all}" }
        ]
      },
      "monitoring-alertsettings": {
        "ClusterId": "monitoring-cluster",
        "Match": { "Path": "/api/AlertSettings/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/AlertSettings/{**catch-all}" }
        ]
      },
      "monitoring-measurements": {
        "ClusterId": "monitoring-cluster",
        "Match": { "Path": "/api/Measurements/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/Measurements/{**catch-all}" }
        ]
      },
      "monitoring-diagnosticroutes": {
        "ClusterId": "monitoring-cluster",
        "Match": { "Path": "/api/DiagnosticRoutes/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/DiagnosticRoutes/{**catch-all}" }
        ]
      },

      "assettracker-api": {
        "ClusterId": "assettracker-cluster",
        "Match": { "Path": "/motor/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/motor/{**catch-all}" }
        ]
      },
      "assettracker-swagger": {
        "ClusterId": "assettracker-cluster",
        "Match": { "Path": "/motor/swagger/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/swagger/{**catch-all}" }
        ]
      },

      "safety-injuries-swagger": {
        "ClusterId": "safety-injuries-cluster",
        "Match": { "Path": "/safety/swagger/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/swagger/{**catch-all}" }
        ]
      },
      "safety-injuries-api": {
        "ClusterId": "safety-injuries-cluster",
        "Match": { "Path": "/safety/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/safety/{**catch-all}" }
        ]
      },

      "humidity-all": {
        "ClusterId": "humidity-cluster",
        "Match": { "Path": "/humidity/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/humidity/{**catch-all}" }
        ]
      },

      "signalr-alerthub": {
        "ClusterId": "monitoring-cluster",
        "Match": { "Path": "/alertHub/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/alertHub/{**catch-all}" }
        ]
      },
      "signalr-negotiate": {
        "ClusterId": "monitoring-cluster",
        "Match": { "Path": "/alertHub/negotiate/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/alertHub/negotiate/{**catch-all}" }
        ]
      },

      "monitoring-swagger": {
        "ClusterId": "monitoring-cluster",
        "Match": { "Path": "/monitoring/swagger/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/swagger/{**catch-all}" }
        ]
      },
      "humidity-swagger": {
        "ClusterId": "humidity-cluster",
        "Match": { "Path": "/humidity/swagger/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/swagger/{**catch-all}" }
        ]
      },

      "authentik-proxy": {
        "ClusterId": "authentik-cluster",
        "Match": { "Path": "/auth/authentik/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/{**catch-all}" }
        ]
      }
    },

    "Clusters": {
      "authentik-cluster": {
        "Destinations": {
          "authentik-server": {
            "Address": "http://authentik-server:9000/"
          }
        }
      },
      "monitoring-cluster": {
        "Destinations": {
          "monitoring-server": {
            "Address": "http://uchaly-vibrationmonitoring-api:8080/"
          }
        }
      },
      "assettracker-cluster": {
        "Destinations": {
          "assettracker-server": {
            "Address": "http://assettracker-api:8080/"
          }
        }
      },
      "humidity-cluster": {
        "Destinations": {
          "humidity-server": {
            "Address": "http://humidity-api:8080/"
          }
        }
      },
      "safety-injuries-cluster": {
        "Destinations": {
          "safety-injuries-server": {
            "Address": "http://safety-injuries-api:8080/"
          }
        }
      }
    }
  }
}